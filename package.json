{
  "name": "agentic-paypal",
  "version": "0.1.0",
  "description": "Agentic PayPal: let any AI agent buy goods for you with PayPal, over MCP. Add it to Claude or Codex, log in with PayPal, and your agent shops from merchants in USD.",
  "type": "module",
  "bin": {
    "agentic-paypal": "dist/index.js"
  },
  "files": [
    "dist",
    "web"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "selftest": "node dist/selftest.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "paypal",
    "agentic-payments",
    "pyusd",
    "usdc",
    "ai-agent",
    "wallet"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "thirdweb": "^5.80.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
