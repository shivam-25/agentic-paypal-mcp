    "selftest": "node dist/selftest.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "paypal",
    "agentic-payments",
    "pyusd",
    "usdc",
    "ai-agent",
    "wallet"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "thirdweb": "^5.80.0",
