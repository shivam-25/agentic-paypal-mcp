{
  "name": "agentic-paypal-mcp",
  "version": "0.2.0",
  "description": "Agentic PayPal — give any AI agent a wallet linked to the user's PayPal account and let it buy goods and services. Small purchases pay automatically within a user-set limit; larger ones ask for PayPal approval. Over MCP, for Claude or Codex.",
  "type": "module",
  "bin": {
    "agentic-paypal-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "selftest": "node dist/selftest.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "paypal",
    "agentic-payments",
    "pyusd",
    "usdc",
    "ai-agent",
    "wallet"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "thirdweb": "^5.80.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
