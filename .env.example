# thirdweb — create at https://thirdweb.com/dashboard (Settings → API Keys)
THIRDWEB_SECRET_KEY=your_thirdweb_secret_key

# PayPal — create a sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret
PAYPAL_ENVIRONMENT=SANDBOX

# Chain / asset (defaults to Arbitrum Sepolia USDC)
AGENTPAY_CHAIN_ID=421614
AGENTPAY_USDC=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d

# Where the agent's wallet metadata is stored (defaults to ~/.agentpay)
# AGENTPAY_HOME=/custom/path
